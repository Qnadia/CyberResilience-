    {
      "id": "s1_note_text",
      "type": "text",
      "x": 80,
      "y": 615,
      "width": 1780,
      "height": 400,
      "angle": 0,
      "strokeColor": "#b0bec5",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "frame_1",
      "roundness": null,
      "seed": 1018,
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Cl.4 – Analyser le contexte (SWOT, PESTEL), identifier les parties intéressées, définir le périmètre du SMSI\nCl.5 – La direction doit démontrer son engagement : politique signée, désignation du RSSI, allocations budgétaires\nCl.6 – Méthodologie d'appréciation des risques (ISO 27005), plan de traitement des risques (PTR), Déclaration d'applicabilité (DdA)\nCl.7 – Ressources humaines, formations, sensibilisation, communication interne/externe, gestion documentaire\nCl.8 – Mise en œuvre du PTR, exécution des contrôles de l'annexe A, gestion opérationnelle des risques\nCl.9 – Indicateurs de performance (KPIs), programme d'audits internes, revue de direction annuelle avec ordre du jour défini\nCl.10 – Traitement des non-conformités (RCA), actions correctives, boucle d'amélioration continue (Kaizen, PDCA)",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Cl.4 – Analyser le contexte (SWOT, PESTEL), identifier les parties intéressées, définir le périmètre du SMSI\nCl.5 – La direction doit démontrer son engagement : politique signée, désignation du RSSI, allocations budgétaires\nCl.6 – Méthodologie d'appréciation des risques (ISO 27005), plan de traitement des risques (PTR), Déclaration d'applicabilité (DdA)\nCl.7 – Ressources humaines, formations, sensibilisation, communication interne/externe, gestion documentaire\nCl.8 – Mise en œuvre du PTR, exécution des contrôles de l'annexe A, gestion opérationnelle des risques\nCl.9 – Indicateurs de performance (KPIs), programme d'audits internes, revue de direction annuelle avec ordre du jour défini\nCl.10 – Traitement des non-conformités (RCA), actions correctives, boucle d'amélioration continue (Kaizen, PDCA)",
      "lineHeight": 1.25
    },
